+/// The titled options of [`EnumSchemaBuilder::build`]: `titles.into_iter().zip(values)
+/// .map(|(title, const_)| ConstTitle { const_, title }).collect()`, written as a loop.
+fn const_titles(titles: Vec<String>, values: Vec<String>) -> Vec<ConstTitle> {
+    let mut values = values.into_iter();
+    let mut out = Vec::new();
+    for title in titles {
+        match values.next() {
+            Some(const_) => out.push(ConstTitle { const_, title }),
+            None => break,
+        }
+    }
+    out
+}
+
+/// Wrappers that the verification translation keeps opaque, each the original expression:
+/// the `format!` of `EnumSchemaBuilder::enum_titles` and the sorted key list of a `BTreeMap`.
+mod prim {
+    use std::collections::BTreeMap;
+
+    use super::PrimitiveSchemaDefinition;
+
+    pub(super) fn titles_mismatch_message(expected: usize, got: usize) -> String {
+        format!(
+            "Provided number of titles do not match number of values: expected {}, but got {}",
+            expected, got
+        )
+    }
+
+    pub(super) fn sorted_keys(
+        properties: &BTreeMap<String, PrimitiveSchemaDefinition>,
+    ) -> Vec<String> {
+        properties.keys().cloned().collect()
+    }
+}
