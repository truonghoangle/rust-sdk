+    // A07 (H5): the value is trimmed of White_Space (ASCII, U+00A0, U+0085, U+3000), not of
+    // U+FEFF; empty after the trim, or neither parsable nor joinable, gives None.
+    #[test]
+    fn d5_a07_resolve_trim_empty_unparsable() {
+        let base = Url::parse("https://mcp.example.com/mcp").unwrap();
+        let resolve = |value: &str| {
+            AuthorizationManager::resolve_resource_metadata_url(value, &base, false)
+                .map(|url| url.to_string())
+        };
+        let target = "https://mcp.example.com/.well-known/oauth-protected-resource";
+        for pad in [" \t\n", "\r\u{0b}\u{0c}", "\u{a0}", "\u{85}", "\u{3000}"] {
+            assert_eq!(
+                resolve(&format!("{pad}{target}{pad}")).as_deref(),
+                Some(target),
+                "padding {pad:?}"
+            );
+        }
+        // U+FEFF is kept: after the URL it is percent-encoded into the path, before it the
+        // value is not absolute and is joined to the base as a relative path.
+        assert_eq!(
+            resolve(&format!("{target}\u{feff}")).as_deref(),
+            Some("https://mcp.example.com/.well-known/oauth-protected-resource%EF%BB%BF")
+        );
+        assert_eq!(
+            resolve(&format!("\u{feff}{target}")).as_deref(),
+            Some(
+                "https://mcp.example.com/%EF%BB%BFhttps://mcp.example.com/.well-known/oauth-protected-resource"
+            )
+        );
+        assert_eq!(resolve("/x").as_deref(), Some("https://mcp.example.com/x"));
+        for value in ["", " \t\r\n", "\u{a0}\u{85}\u{3000}"] {
+            assert_eq!(resolve(value), None, "{value:?}");
+        }
+        for value in ["http://[::1", "https://ex ample.com/", " http://[::1 "] {
+            assert!(Url::parse(value.trim()).is_err() && base.join(value.trim()).is_err());
+            assert_eq!(resolve(value), None, "{value:?}");
+        }
+    }
