diff --git a/crates/rmcp/src/transport/common/mcp_headers.rs b/crates/rmcp/src/transport/common/mcp_headers.rs
index 9882884..4ee60aa 100644
--- a/crates/rmcp/src/transport/common/mcp_headers.rs
+++ b/crates/rmcp/src/transport/common/mcp_headers.rs
@@ -1138,4 +1138,229 @@ mod tests {
             );
         }
     }
+
+    // ---- Patch 02 (human decision GD3, 2026-11-27): the mcp_headers.rs paths that
+    // 07-mcp-headers.patch rewrites (G01-G04) and that no upstream test pins. Expected values
+    // are computed from the upstream source at 7caec76 (requires_base64, is_tchar,
+    // encode_header_value, decode_header_value, BASE64_HEADER_PREFIX/SUFFIX of http_header.rs,
+    // the BASE64_STANDARD engine of base64 0.23), not from the Lean model.
+
+    // G01: the empty string, a lone space or tab, white space inside only, U+001F, DEL,
+    // non-ASCII, and the sentinel test (prefix at the start and suffix at the end both
+    // required, and they may overlap).
+    #[test]
+    fn g07_requires_base64_boundaries() {
+        for (value, expected) in [
+            ("", false),
+            (" ", true),
+            ("\t", true),
+            ("a b", false),
+            ("a\tb", true),
+            ("\u{1f}", true),
+            ("a\u{1f}b", true),
+            ("\u{7f}", true),
+            ("a\u{7f}b", true),
+            ("~", false),
+            ("\u{80}", true),
+            ("é", true),
+            ("=?base64??=", true),
+            ("=?base64?abc?=", true),
+            ("=?base64?=", true),
+            ("=?base64?abc", false),
+            ("=?base64?", false),
+            ("abc?=", false),
+            ("x=?base64?abc?=", false),
+            ("=?base64?=x", false),
+            ("=?base64?a?=b", false),
+        ] {
+            assert_eq!(
+                requires_base64(value),
+                expected,
+                "requires_base64({value:?})"
+            );
+        }
+    }
+
+    // G02: every RFC 9110 token punctuation char (the quote in particular: patch 07 writes it
+    // as `char::from(b'\'')`), the alphanumeric bounds, and the delimiters and other non-tchars.
+    #[test]
+    fn g07_is_tchar_boundaries() {
+        for c in [
+            '!', '#', '$', '%', '&', '\'', '*', '+', '-', '.', '^', '_', '`', '|', '~',
+        ] {
+            assert!(is_tchar(c), "{c:?} is a tchar");
+        }
+        assert!(is_tchar('\''));
+        for c in ['0', '9', 'a', 'z', 'A', 'Z'] {
+            assert!(is_tchar(c), "{c:?} is a tchar");
+        }
+        for c in [
+            '"', '(', ')', ',', '/', ':', ';', '<', '=', '>', '?', '@', '[', '\\', ']', '{', '}',
+            ' ', '\t', '\0', '\u{7f}', 'é', '\u{ff07}',
+        ] {
+            assert!(!is_tchar(c), "{c:?} is not a tchar");
+        }
+        // Exactly 62 alphanumerics and 15 punctuation chars among the ASCII chars.
+        assert_eq!(
+            (0u8..=0x7F).filter(|b| is_tchar(char::from(*b))).count(),
+            77
+        );
+    }
+
+    // G04: a prefix without a suffix after it (patch 07's inner `None` arm), a value without the
+    // prefix, and sentinels that wrap non-UTF-8 bytes, invalid Base64 (also white space around
+    // the payload, which is not trimmed), or non-canonical padding or trailing bits.
+    #[test]
+    fn g07_decode_header_value_boundaries() {
+        for value in [
+            "=?base64?abc",
+            "=?base64?",
+            "=?base64?=",
+            "=?base64?/w==",
+            "us-west1",
+            "",
+            "abc?=",
+            " =?base64?YQ==?=",
+        ] {
+            assert_eq!(
+                decode_header_value(value).as_deref(),
+                Some(value),
+                "decode_header_value({value:?})"
+            );
+        }
+        assert_eq!(decode_header_value("=?base64??=").as_deref(), Some(""));
+        assert_eq!(decode_header_value("=?base64?YQ==?=").as_deref(), Some("a"));
+        for value in [
+            // 0xFF and 0xC3 0x28: not UTF-8.
+            "=?base64?/w==?=",
+            "=?base64?wyg=?=",
+            // Not Base64.
+            "=?base64?!!!!?=",
+            "=?base64?abc?=",
+            "=?base64?YQ=?=",
+            "=?base64?YQ===?=",
+            "=?base64?YQ?=",
+            // Non-zero trailing bits.
+            "=?base64?YR==?=",
+            "=?base64?YWJ=?=",
+            // White space around the payload: not trimmed before decoding.
+            "=?base64? YQ==?=",
+            "=?base64?YQ== ?=",
+        ] {
+            assert_eq!(
+                decode_header_value(value),
+                None,
+                "decode_header_value({value:?})"
+            );
+        }
+    }
+
+    // G03 and G04: decoding an encoded value gives the value back, and the encoded value is a
+    // valid header value (visible ASCII and space only, no space or tab at either end).
+    #[test]
+    fn g07_round_trip_and_header_safe() {
+        let long = "x-".repeat(600);
+        for value in [
+            "",
+            " a",
+            "a ",
+            "\t",
+            "\r\n",
+            "x\ny",
+            "é",
+            "=?base64?abc?=",
+            "=?base64??=",
+            "=?base64?=",
+            "=?base64?abc",
+            "a'b",
+            long.as_str(),
+        ] {
+            let encoded = encode_header_value(value);
+            assert_eq!(
+                decode_header_value(&encoded).as_deref(),
+                Some(value),
+                "round trip of {value:?} via {encoded:?}"
+            );
+            assert!(
+                encoded.bytes().all(|b| (0x20..0x7F).contains(&b)),
+                "{encoded:?} has a control or non-ASCII byte"
+            );
+            assert!(
+                !encoded.starts_with([' ', '\t']) && !encoded.ends_with([' ', '\t']),
+                "{encoded:?} starts or ends with white space"
+            );
+            assert!(HeaderValue::from_str(&encoded).is_ok(), "{encoded:?}");
+            assert_eq!(encoded != value, requires_base64(value), "{value:?}");
+        }
+    }
+
+    // Mutation vectors: they pin the standard Base64 alphabet (`+` and `/`), the sentinel
+    // placement (the whole prefix at the start, the whole suffix `?=` at the end), the
+    // stripping of the suffix (at the end only) and of the prefix (once, at the start), a
+    // trailing NUL byte, and the count 77 of tchars among all chars. Expected values come from
+    // upstream Rust (7caec76) and were cross-checked with Python's base64 module.
+    #[test]
+    fn g07_mutation_vectors() {
+        for (value, expected) in [
+            ("=?base64?a=", false),
+            ("=?x?=", false),
+            ("=?base64x?=", false),
+        ] {
+            assert_eq!(
+                requires_base64(value),
+                expected,
+                "requires_base64({value:?})"
+            );
+        }
+        assert_eq!(encode_header_value("é?"), "=?base64?w6k/?=");
+        assert_eq!(encode_header_value("é>"), "=?base64?w6k+?=");
+        assert_eq!(encode_header_value("\t~~"), "=?base64?CX5+?=");
+        assert_eq!(
+            decode_header_value("=?base64?Pz8/?=").as_deref(),
+            Some("???")
+        );
+        assert_eq!(
+            decode_header_value("=?base64?fn5+?=").as_deref(),
+            Some("~~~")
+        );
+        assert_eq!(
+            decode_header_value("=?base64?AA==?=").as_deref(),
+            Some("\0")
+        );
+        for value in ["=?base64?YQ==?=x", "=?base64?YQ==?= "] {
+            assert_eq!(
+                decode_header_value(value).as_deref(),
+                Some(value),
+                "{value:?}"
+            );
+        }
+        for value in [
+            "=?base64?YQ==?=?=",
+            "=?base64?=?base64?YQ==?=",
+            "=?base64?Pz8_?=",
+            "=?base64?fn5-?=",
+        ] {
+            assert_eq!(decode_header_value(value), None, "{value:?}");
+        }
+        assert_eq!(
+            (0..=0x10FFFFu32)
+                .filter_map(char::from_u32)
+                .filter(|c| is_tchar(*c))
+                .count(),
+            77
+        );
+        // A char whose low byte is printable (U+0141), a char outside the BMP, NUL, a
+        // non-ASCII char after the first 256 chars, the sentinel in upper case (the prefix is
+        // case-sensitive), and a line break inside the payload (not removed before decoding).
+        for v in ["Ł", "😀", "\0"] {
+            assert!(requires_base64(v), "{v:?}");
+        }
+        assert!(requires_base64(&format!("{}é", "a".repeat(256))));
+        assert!(!requires_base64("=?BASE64?x?="));
+        assert_eq!(
+            decode_header_value("=?BASE64?YQ==?=").as_deref(),
+            Some("=?BASE64?YQ==?=")
+        );
+        assert_eq!(decode_header_value("=?base64?YQ\n==?="), None);
+    }
 }
