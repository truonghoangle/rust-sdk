+            resource: Some(resource.to_owned()),
+            authorization_server: None,
+            authorization_servers: None,
+            scopes_supported: None,
+        };
+        assert_eq!(
+            manager.validate_resource_metadata_resource(&metadata("https://a.example:8443/mcp")),
+            Err(Box::new(
+                ProtectedResourceMetadataInvalidReason::ResourceMismatch {
+                    reference: Url::parse("https://a.example/mcp").unwrap(),
+                    permitted: Url::parse("https://a.example:8443/mcp").unwrap(),
+                }
+            ))
+        );
+        assert_eq!(
+            manager.validate_resource_metadata_resource(&metadata("https://a.example:443/mcp")),
+            Ok(())
+        );
+    }
+
+    // A06 (H4): a target that is not http(s) is never an allowed metadata URL, even with a
+    // public host; through resolve_resource_metadata_url (http base, so no downgrade check) too.
+    #[test]
+    fn d5_a06_non_http_target() {
+        let base = Url::parse("http://example.com/").unwrap();
+        let ftp = Url::parse("ftp://metadata-host.example/x").unwrap();
+        for allow in [false, true] {
+            assert!(!AuthorizationManager::is_allowed_metadata_url(
+                &base, &ftp, allow
+            ));
+        }
+        assert_eq!(
+            AuthorizationManager::resolve_resource_metadata_url(
+                "ftp://public.example/x",
+                &Url::parse("http://example.com/mcp").unwrap(),
+                false
+            ),
+            None
+        );
+    }
+
+    // A06 (H4): a loopback base allows a disallowed target only when the target is loopback
+    // too (the SSRF guard); a link-local IP or a cloud-metadata name is never allowed.
+    #[test]
+    fn d5_a06_loopback_base_target() {
+        let allowed = |base: &str, target: &str| {
+            AuthorizationManager::is_allowed_metadata_url(
+                &Url::parse(base).unwrap(),
+                &Url::parse(target).unwrap(),
+                false,
+            )
+        };
+        assert!(!allowed(
+            "http://localhost:8080/mcp",
+            "http://169.254.169.254/latest"
+        ));
+        assert!(!allowed(
+            "http://127.0.0.1:8080/mcp",
+            "http://metadata.google.internal/x"
+        ));
+        assert!(allowed(
+            "http://localhost:8080/mcp",
+            "http://127.0.0.1:9000/x"
+        ));
+    }
+
+    // A07 (H5): a value that parses as an absolute URL is taken as is, not joined to the base:
+    // `https:public.example/x` is https://public.example/x, not a path below the base.
+    #[test]
+    fn d5_a07_resolve_parse_before_join() {
+        assert_eq!(
+            AuthorizationManager::resolve_resource_metadata_url(
+                "https:public.example/x",
+                &Url::parse("https://example.com/a/b").unwrap(),
+                false
+            )
+            .map(|url| url.to_string()),
+            Some("https://public.example/x".to_owned())
+        );
+    }
+
+    // A10 (H9, H10): the scheme is part of the resource identity, also with the same host and
+    // the same explicit port.
+    #[test]
+    fn d5_a10_resource_identifier_scheme() {
+        assert!(!AuthorizationManager::is_resource_identifier_valid(
+            &Url::parse("https://a.example:8443/mcp").unwrap(),
+            &Url::parse("http://a.example:8443/mcp").unwrap(),
+        ));
+    }
 }
