+    // A08 (H6): every path of validate_authorization_response_issuer, with exact payloads; the
+    // comparison is exact (no trailing-slash equivalence).
+    #[test]
+    fn d5_a08_response_issuer_paths() {
+        const NOT_RECORDED: &str = "Authorization callback issuer cannot be validated because expected issuer was not recorded";
+        const ISS: &str = "https://auth.example.com";
+        let check = |expected: Option<&str>, require: bool, received: Option<&str>| {
+            AuthorizationManager::validate_authorization_response_issuer(
+                &d5_stored_state(expected, require),
+                received,
+            )
+            .map_err(d5_issuer_error)
+        };
+        let failed = Err(("failed", NOT_RECORDED.to_owned(), String::new()));
+        assert_eq!(check(None, false, None), Ok(()));
+        assert_eq!(check(None, false, Some(ISS)), failed);
+        assert_eq!(check(None, true, None), failed);
+        assert_eq!(check(None, true, Some(ISS)), failed);
+        assert_eq!(check(Some(ISS), false, None), Ok(()));
+        assert_eq!(
+            check(Some(ISS), true, None),
+            Err(("missing", ISS.to_owned(), String::new()))
+        );
+        assert_eq!(check(Some(ISS), true, Some(ISS)), Ok(()));
+        assert_eq!(
+            check(Some(ISS), false, Some("https://auth.example.com/")),
+            Err((
+                "mismatch",
+                ISS.to_owned(),
+                "https://auth.example.com/".to_owned()
+            ))
+        );
+    }
