+    // A05 (H1, H2): each cloud-metadata name and `.localhost`, after the trailing dots are
+    // trimmed and the name lowercased; near misses are allowed.
+    #[test]
+    fn d5_a05_metadata_host_names() {
+        use url::Host;
+        let blocked = [
+            "metadata",
+            "metadata.google.internal",
+            "metadata.azure.internal",
+            "METADATA.Azure.Internal.",
+            "Metadata.GOOGLE.internal..",
+            "metadata.",
+            "localhost",
+            "localhost.",
+            "foo.localhost",
+            "FOO.LOCALHOST.",
+            ".localhost",
+        ];
+        let allowed = [
+            "metadata2",
+            "xmetadata",
+            "metadata.google.internal.example",
+            "metadata.azure",
+            "metadata-azure-internal",
+            "notlocalhost",
+            "localhost.example",
+            "localhostx",
+            "a.localhost.example",
