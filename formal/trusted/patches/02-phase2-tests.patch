+    fn d5_issuer_error(error: AuthError) -> (&'static str, String, String) {
+        match error {
+            AuthError::AuthorizationFailed(message) => ("failed", message, String::new()),
+            AuthError::AuthorizationServerMissingIssuer { expected_issuer } => {
+                ("missing", expected_issuer, String::new())
+            }
+            AuthError::AuthorizationServerMismatch {
+                expected_issuer,
+                received_issuer,
+            } => ("mismatch", expected_issuer, received_issuer),
+            other => panic!("unexpected error {other:?}"),
+        }
+    }
